# /etc/systemd/system/tap-lms-feedback-consumer.service

[Unit]
Description=TAP LMS RabbitMQ Feedback Consumer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ishan
Group=ishan
WorkingDirectory=/home/ishan/frappe-bench
Environment=PATH=/home/ishan/frappe-bench/env/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/bench --site tap_lms.prod execute tap_lms.feedback_handler.consumer_runner.run

Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target